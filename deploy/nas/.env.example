# Copy to deploy/nas/.env on the TrueNAS box. Gitignored -- holds real secrets.

# The Pi's LAN address. Pin it with a DHCP reservation; mDNS (coldbrewer.local)
# does not resolve from inside a container.
BREWCTL_PI_IP=192.168.0.224

BREWCTL_INFLUXDB_URL=http://influxdb.catacombs.local
BREWCTL_INFLUXDB_ORG=catacombs
BREWCTL_INFLUXDB_BUCKET=coldbrew
# Rotate this: the previous value lived in ~/.profile on the Pi, which no longer
# needs InfluxDB access at all.
BREWCTL_INFLUXDB_TOKEN=

BREWCTL_VALVE_INTERVAL_SECONDS=90
