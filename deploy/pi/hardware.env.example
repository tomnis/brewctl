# BrewCTL hardware service configuration.
#
# Installed to /etc/brewctl/hardware.env (mode 0600) by deploy/pi/install.sh.
# systemd reads this via EnvironmentFile -- note that means no shell syntax:
# no `export`, no quotes-with-expansion, no comments on the same line as a value.
#
# Only what the hardware service actually reads. InfluxDB credentials
# deliberately do NOT belong here -- only the api service talks to InfluxDB.

# Selects brewctl/hardware/server.py in brewctl/main.py. Must be "hardware".
BREWCTL_MODE=hardware

# THE important one. When this is not exactly "true", create_scale() and
# create_valve() return MockScale/MockValve: the service starts, /health reports
# healthy, and nothing physical moves. Check the startup log for
# "Initializing production ..." after any config change.
BREWCTL_IS_PROD=true

# Acaia Lunar BLE MAC. Find it with: bluetoothctl scan on
BREWCTL_SCALE_MAC_ADDRESS=60:8a:10:4d:5f:ac

# Which MotorKit stepper drives the valve (1 or 2).
BREWCTL_VALVE_MOTOR_NUMBER=1

# Deadman switch. If no valve command or heartbeat arrives for this many seconds
# while the valve is off its start position, the valve is closed. The api
# heartbeats every 3s, and that now crosses wifi -- raise this if the link
# proves flaky enough to close the valve mid-brew.
BREWCTL_WATCHDOG_TIMEOUT_SECONDS=10.0

BREWCTL_HARDWARE_LOG_LEVEL=INFO
