#!/usr/bin/env bash
#
# Git hook for the Pi's bare repo. Install to ~/coldbrewer.git/hooks/pre-receive.
#
# Refuses a deploy while a brew is running.
#
# Restarting the hardware service mid-brew is worse than it sounds, because valve
# position lives only in the process: MotorKitValve.__init__ does
# `self.breadcrumbs = dict()`, so a restart wipes it and
# directions_to_return_to_start() then returns (None, 0). The valve never goes
# back to its physical start -- not on completion, not on stop, not on a watchdog
# trip -- while get_position() reports 0, so the api and the UI both believe a
# physically open valve is closed. The watchdog cannot save it either: a fresh
# process has no recorded heartbeat, so it starts on the 300s backstop tier and
# the return_to_start it eventually calls is the no-op above.
#
# pre-receive, NOT post-receive: this has to reject before any ref moves.
# post-receive runs after the refs are updated and after its own `checkout -f`,
# so refusing there would leave the bare repo advanced and the work tree
# rewritten while the service still ran the old code -- a box diverged from git
# with nothing pointing at the cause.
#
# Override: `git push -o brewctl-force` (or `make deploy-pi FORCE=1`). That needs
# `git config receive.advertisePushOptions true` on the bare repo, otherwise the
# push is rejected client-side and the override silently does not exist.
#
# deploy/nas/apply.sh gates the api deploy on the same endpoint with the same
# fail-open reasoning. Kept as a separate copy on purpose: this file lives in
# ~/coldbrewer.git/hooks/, not in the work tree, so sourcing a shared library
# would buy a path and chicken-and-egg problem for ~25 lines.

set -uo pipefail   # no -e; the decision below is made explicitly, not by exit codes

# Consume the ref list. We gate the push as a whole rather than per-ref: the
# service restart that follows is per-push, not per-ref.
cat >/dev/null

BREWCTL_API_URL="${BREWCTL_API_URL:-http://192.168.0.69:8000}"
# Optional, and optional on purpose: the default above matches apply.sh, so a Pi
# needs no new config unless the api moves. install.sh does not write this file.
# shellcheck disable=SC1091
[[ -r /etc/brewctl/deploy.env ]] && . /etc/brewctl/deploy.env

warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
# Each argument is one line: continuation lines must not carry this file's
# indentation into the operator's terminal.
die() {
    printf '\033[1;31mpush refused:\033[0m %s\n' "$1" >&2
    shift
    for line in "$@"; do printf '  %s\n' "$line" >&2; done
    exit 1
}
log()  { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }

# ---------------------------------------------------------------- force ---
# Push options arrive as GIT_PUSH_OPTION_0..N with GIT_PUSH_OPTION_COUNT set.
forced=0
for (( i = 0; i < ${GIT_PUSH_OPTION_COUNT:-0}; i++ )); do
    varname="GIT_PUSH_OPTION_$i"
    [[ "${!varname:-}" == "brewctl-force" ]] && forced=1
done

# ------------------------------------------------------------ brew state ---
# python3 rather than curl+jq: preflight.sh verifies neither of those on the Pi,
# but python3 is already mandatory (install.sh builds a venv with it). Same
# reason the container healthcheck in deploy/nas/app.yaml probes with urllib.
log "Checking for an active brew at $BREWCTL_API_URL"
state=$(BREWCTL_API_URL="$BREWCTL_API_URL" python3 - <<'PY'
import json
import os
import socket
import urllib.error
import urllib.request

url = os.environ["BREWCTL_API_URL"].rstrip("/") + "/api/brew/status"

try:
    # Generous: /api/brew/status takes seconds, occasionally tens of seconds.
    with urllib.request.urlopen(url, timeout=30) as response:
        body = json.load(response)
except urllib.error.HTTPError:
    # A responding api is a running api, quite possibly mid-brew.
    print("undetermined")
except urllib.error.URLError as e:
    # Only a refused connection or an unresolvable host means there is genuinely
    # nothing there. A timeout is NOT the same as absent -- a slow api is a
    # running api, so it must not fail open.
    if isinstance(e.reason, (ConnectionRefusedError, socket.gaierror)):
        print("unreachable")
    else:
        print("undetermined")
except (TimeoutError, socket.timeout):
    print("undetermined")
except Exception:
    print("undetermined")
else:
    # Gate on the state, not on a brew existing: cur_brew survives COMPLETED, so
    # "is there a brew" would block every deploy after the first finished one.
    print(str(body.get("brew_state", "unknown")).strip().lower() or "unknown")
PY
)

case "$state" in
    # ERROR counts as active: brew_step_task loops while BREWING or ERROR and
    # keeps driving the valve, so an errored brew still holds hardware and is
    # still recoverable.
    brewing|paused|error)
        if [[ "$forced" == 1 ]]; then
            warn "A brew is $state -- deploying anyway (-o brewctl-force)."
            warn "The restart loses the valve's position. Check it physically when the brew ends."
        else
            die "a brew is $state and the hardware service is holding the valve." \
                "Restarting it loses the valve's position: return_to_start() becomes a no-op," \
                "so a valve left open stays open while the UI reports it closed." \
                "Stop the brew first, or push with: make deploy-pi FORCE=1"
        fi
        ;;
    unreachable)
        # Fail open. Failing closed would mean a crashlooping api blocks the
        # deploy that fixes it.
        log "API unreachable -- proceeding (cannot deploy a fix otherwise)"
        ;;
    undetermined)
        if [[ "$forced" == 1 ]]; then
            warn "Brew state could not be determined -- deploying anyway (-o brewctl-force)."
        else
            die "could not determine brew state -- the api answered slowly, or with an error." \
                "That is not the same as 'no brew': a slow api is a running api and may be" \
                "mid-brew, so this fails closed on purpose." \
                "Retry, or push with: make deploy-pi FORCE=1"
        fi
        ;;
    *)
        log "No active brew (state: $state)"
        ;;
esac

# Note: TOCTOU is accepted. A brew can start between here and the restart that
# post-receive performs.
exit 0
