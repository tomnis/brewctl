# Local deploy settings for apply.sh. This file is untracked -- the committed
# copy is env.example beside it. Real environment variables win over anything
# written here, so CI-style exports always take precedence.
#
# apply.sh resolves this file relative to ITS OWN location, not the working
# directory, so `make deploy-control` from the repo root picks it up.

BREWCTL_API_URL=http://control.internal:8000

# Also sourced if uncommented (same precedence rules). CI supplies these from
# Forgejo vars/secrets instead (.forgejo/workflows/deploy.yml).
#TRUENAS_URL=https://truenas.internal
#TRUENAS_API_KEY=***
